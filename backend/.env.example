# Supabase connection (service role bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Worker config
SYNC_INTERVAL_SECONDS=3600
LIVE_POLL_INTERVAL_SECONDS=120
LIVE_POLL_START_MINUTES=30
